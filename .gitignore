yarn-error.log*
pnpm-debug.log*

node_modules
dist
dist-ssr
release

# PR proof screenshots (local verification artifacts, never committed)
.create-pr-proof/

# changelog-card tool: cached webfonts + generated cards
scripts/changelog-card/.fonts/
changelog-*.png
# Files like config.local and .env.local, at any depth. Written `?*.local`,
# not `*.local`: Knip (bun run dead-code) matches root .gitignore patterns
# against absolute paths, so `*.local` also matched a `.local` folder above the
# checkout (~/.local/share/opencode/worktree/...) and every file looked
# ignored. `?*` needs one character before `.local`, which a bare `.local`
# never has; Git ignores the same files as before.
?*.local
*.tgz
*.vsix
/npm
/tsc
/openchamber@*
local-dev*
.tmp/
/tmp/
